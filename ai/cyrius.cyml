# chakshu — `shu-ai` build manifest (lean core from ../src/* plus the AI chain).
# Rationale, dep history and binary sizes: docs/development/state.md ("Dependency
# Envelope"); per-bump detail: CHANGELOG.md. Keep this file to compilation facts.
[package]
name = "chakshu-ai"
version = "${file:../VERSION}"
description = "shu-ai — the AI-augmented build of chakshu (monitor + hoosh explain panel)"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/chakshu"
language = "cyrius"
cyrius = "6.5.45"

[build]
entry = "main.cyr"
output = "shu-ai"
test = "tests/chakshu-ai.tcyr"

# Root manifest's stdlib list plus the AI chain. sandhi is consumed as a STDLIB
# module (never a git dep) so its bare socket/tls constants resolve alongside
# net/tls; the async..thread_local entries are sandhi's transitive references and
# unicode is niyama's.
# ⛔ `fdlopen` and `dynlib` are deliberately ABSENT — they are the dlopen bridges.
# TLS runs on
# the native backend and ../src/nolibc.cyr hard-refuses the libssl path; see that
# file. `random` supplies getrandom(2) entropy for the native handshake.
[deps]
stdlib = [
    "syscalls", "alloc", "fmt", "io", "fs", "str", "string", "slice", "vec",
    "args", "chrono", "hashmap", "process", "tagged", "assert", "sys",
    "fnptr", "thread", "freelist", "ct", "bench",
    "unicode",
    "async", "atomic", "regression", "mmap", "random",
    "net", "http", "tls", "ws", "sakshi", "sigil", "keccak", "thread_local",
    "sandhi",
]

# These three blocks are kept in lockstep with the root manifest; do not drift.
[deps.darshana]
git = "https://github.com/MacCracken/darshana.git"
tag = "1.0.0"
modules = ["dist/darshana.cyr"]

[deps.mihi]
git = "https://github.com/MacCracken/mihi.git"
tag = "1.2.5"
modules = ["dist/mihi.cyr"]

# Pin TRACKS mihi's own [deps.ai-hwaccel] tag, NOT ai-hwaccel's latest release.
[deps.ai-hwaccel]
git = "https://github.com/MacCracken/ai-hwaccel.git"
tag = "2.3.19"
modules = ["dist/ai-hwaccel.cyr"]

# re2 secret redaction (src/ai.cyr). Git dep ONLY — cyrius >= 6.5.30 also ships
# lib/niyama.cyr, and consuming it both ways would duplicate every niyama_* symbol.
[deps.niyama]
git = "https://github.com/MacCracken/niyama.git"
tag = "1.0.7"
modules = ["dist/niyama.cyr"]

# Declared at the full bundle so ai-hwaccel's transitive dist/bayan-json.cyr sublib
# does not land beside it. cyrius >= 6.5.39 keeps its own folded lib/bayan.cyr and
# skips this artifact, so the tag selects no bytes — keep it naming what links.
[deps.bayan]
git = "https://github.com/MacCracken/bayan.git"
tag = "1.5.4"
modules = ["dist/bayan.cyr"]
