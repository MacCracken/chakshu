# shu-ai test suite — the AI module (src/ai.cyr). Covers the pure,
# verifiable parts: niyama-driven secret redaction (privacy-critical),
# prompt assembly, and the hoosh JSON request/response marshalling. The
# live POST itself needs a running hoosh gateway and is verified manually.
# Run from ai/: `cyrius test tests/chakshu-ai.tcyr`.
#
# Needs the AI dep chain: niyama (re2) + mihi (→ ai-hwaccel) for the
# _ai_system_summary link; sandhi is auto-included (stdlib).
include "lib/ai-hwaccel.cyr"
include "lib/mihi.cyr"
include "lib/niyama.cyr"
# v0.8.1: ai.cyr's --with-logs context reads the anomaly ring, so the suite
# needs watch.cyr in scope. It is the transport-free half of the watch module
# (the TUI-dependent render lives in watch_render.cyr), so including it here
# costs no TUI dependency.
include "../src/watch.cyr"
include "../src/proc.cyr"
include "../src/processes.cyr"
include "../src/ai.cyr"

# ai.cyr's ai_explain returns these app-wide exit codes (defined in
# cli.cyr, not included here); ai_explain itself isn't asserted, only the
# pure helpers, so provide the constants for a clean link.
var EXIT_OK  = 0;
var EXIT_ERR = 1;

# Same reason: ai.cyr's overlay waits on the TUI's exit signalfd (v0.7.13 R14),
# which tui.cyr owns and this suite does not include. -1 is the "no signalfd"
# value, which is exactly the state a non-TUI test run is in — the overlay then
# takes its plain blocking-read path.
var _tui_sfd_exit = 0 - 1;

fn main() {
    alloc_init();

    # ----- M3 foundation (v0.7.2) — redaction + assembly --------------
    # Secret redaction is privacy-critical (design-spec §6.2): a value
    # that should be stripped must never reach the prompt. Exact-output
    # assertions so a regression is unambiguous.
    test_group("ai.cyr — secret redaction (niyama re2)");
    var rbuf[256];

    var c1 = "--password=hunter2 --port=8080";
    ai_redact_cmdline(c1, strlen(c1), &rbuf, 256);
    assert_eq(streq(&rbuf, "--password=*** --port=8080"), 1, "redacts --password value, keeps --port");

    var c2 = "API_KEY=abc123 --verbose";
    ai_redact_cmdline(c2, strlen(c2), &rbuf, 256);
    assert_eq(streq(&rbuf, "API_KEY=*** --verbose"), 1, "redacts API_KEY value (KEY anywhere in key)");

    var c3 = "--token=xyz";
    ai_redact_cmdline(c3, strlen(c3), &rbuf, 256);
    assert_eq(streq(&rbuf, "--token=***"), 1, "redacts a lone --token value");

    var c4 = "nginx -g daemon off;";
    ai_redact_cmdline(c4, strlen(c4), &rbuf, 256);
    assert_eq(streq(&rbuf, "nginx -g daemon off;"), 1, "tokens without '=' pass through unchanged");

    var c5 = "--secret=s --user=bob --passwd=p";
    ai_redact_cmdline(c5, strlen(c5), &rbuf, 256);
    assert_eq(streq(&rbuf, "--secret=*** --user=bob --passwd=***"), 1, "redacts secret/passwd, keeps --user");

    var c6 = "--port=8080 --host=localhost";
    ai_redact_cmdline(c6, strlen(c6), &rbuf, 256);
    assert_eq(streq(&rbuf, "--port=8080 --host=localhost"), 1, "benign key=value tokens untouched");

    # ---- R1/R2 (v0.7.13 P-1 sweep) — real credential shapes that used to
    # ship VERBATIM to hoosh. Each of these failed before the sweep.

    # R1: the old pattern case-folded only the LEADING letter, so every
    # SCREAMING_CASE environment-style key leaked its value.
    var u1 = "PASSWORD=hunter2 TOKEN=abc SECRET=s PASSWD=p";
    ai_redact_cmdline(u1, strlen(u1), &rbuf, 256);
    assert_eq(streq(&rbuf, "PASSWORD=*** TOKEN=*** SECRET=*** PASSWD=***"), 1, "uppercase secret keys redacted");

    var u2 = "docker run -e MYSQL_ROOT_PASSWORD=s3cr3t nginx";
    ai_redact_cmdline(u2, strlen(u2), &rbuf, 256);
    assert_eq(streq(&rbuf, "docker run -e MYSQL_ROOT_PASSWORD=*** nginx"), 1, "compound uppercase env key redacted");

    # R2a: space-separated value — the secret is the NEXT token, not after '='.
    var u3 = "psql --password hunter2 --host db";
    ai_redact_cmdline(u3, strlen(u3), &rbuf, 256);
    assert_eq(streq(&rbuf, "psql --password *** --host db"), 1, "space-separated secret value redacted");

    # R2b: shape rules — these carry no key at all.
    var u4 = "curl -H eyJhbGciOiJIUzI1NiJ9.payload.sig";
    ai_redact_cmdline(u4, strlen(u4), &rbuf, 256);
    assert_eq(streq(&rbuf, "curl -H ***"), 1, "JWT redacted by shape");

    var u5 = "aws --key AKIAIOSFODNN7EXAMPLE";
    ai_redact_cmdline(u5, strlen(u5), &rbuf, 256);
    assert_eq(streq(&rbuf, "aws --key ***"), 1, "AWS access key id redacted");

    var u6 = "psql postgres://bob:hunter2@db.internal/app";
    ai_redact_cmdline(u6, strlen(u6), &rbuf, 256);
    assert_eq(streq(&rbuf, "psql postgres://bob:***@db.internal/app"), 1, "URL userinfo password redacted, host kept");

    # R2 over-fire pin: a secret key WITH '=' must NOT arm the lookback and
    # swallow the following benign token.
    var u7 = "--password=hunter2 --port=8080";
    ai_redact_cmdline(u7, strlen(u7), &rbuf, 256);
    assert_eq(streq(&rbuf, "--password=*** --port=8080"), 1, "lookback does not over-fire after key=value");

    var u8 = "myapp --keyring-path /etc/app --port 8080";
    ai_redact_cmdline(u8, strlen(u8), &rbuf, 256);
    assert_eq(streq(&rbuf, "myapp --keyring-path *** --port 8080"), 1, "lookback fires once, next flag pair intact");

    # ----- --with-logs context (v0.8.1) -------------------------------
    # The opt-in must be genuinely OFF by default: a prompt built without it
    # must carry no anomaly section even when the ring has events. This is the
    # privacy-critical half — an opt-in that leaks when unset is worse than no
    # opt-in, because the user believes it is off.
    test_group("ai.cyr — --with-logs opt-in");
    watch_reset();
    watch_ingest_line("{\"timestamp\":\"2026-08-25T04:00:00Z\",\"event_type\":\"SandboxEscape\",\"threat_level\":\"Critical\",\"description\":\"escape attempt\"}");
    assert_eq(watch_count(), 1, "ring seeded for the opt-in test");

    ai_set_with_logs(0);
    var pbuf_off[2048];
    ai_build_prompt(&pbuf_off, 2048, 1234, "nginx", 83, 1, 33, 4096, "--token=***", "load 0.1 0.2 0.3  mem 100/200 MiB");
    assert_eq(strstr(&pbuf_off, "recent anomalies"), 0 - 1, "no anomaly section when opt-in is off");
    assert_eq(strstr(&pbuf_off, "escape attempt"), 0 - 1, "no event text leaks when opt-in is off");

    ai_set_with_logs(1);
    var pbuf_on[2048];
    ai_build_prompt(&pbuf_on, 2048, 1234, "nginx", 83, 1, 33, 4096, "--token=***", "load 0.1 0.2 0.3  mem 100/200 MiB");
    assert(strstr(&pbuf_on, "recent anomalies") >= 0, "anomaly section present when opt-in is on");
    assert(strstr(&pbuf_on, "escape attempt") >= 0, "event text reaches the prompt when opted in");
    assert(strstr(&pbuf_on, "CRIT") >= 0, "severity label reaches the prompt");
    assert(strstr(&pbuf_on, "process: nginx") >= 0, "process facts still present alongside the context");

    # A secret inside a daemon-authored event must be redacted on the way into
    # the prompt — the event text is NOT trusted just because it came from a
    # local daemon.
    watch_reset();
    watch_ingest_line("{\"event_type\":\"PolicyViolation\",\"threat_level\":\"Low\",\"description\":\"spawned psql --password hunter2\"}");
    var pbuf_red[2048];
    ai_build_prompt(&pbuf_red, 2048, 1, "x", 83, 1, 0, 0, "-", "-");
    assert_eq(strstr(&pbuf_red, "hunter2"), 0 - 1, "secret in an event is redacted before the prompt");
    assert(strstr(&pbuf_red, "psql") >= 0, "surrounding event context survives redaction");

    ai_set_with_logs(0);
    watch_reset();

    test_group("ai.cyr — prompt assembly");
    var pbuf[2048];
    var pl = ai_build_prompt(&pbuf, 2048, 1234, "nginx", 83, 1, 33, 4096, "--token=***", "load 0.1 0.2 0.3  mem 100/200 MiB");
    assert(pl > 0, "prompt has nonzero length");
    assert_eq(memeq(&pbuf, "Explain this Linux process", 26), 1, "prompt opens with the framing line");

    # ----- M3 live transport (v0.7.3) — JSON marshalling -------------
    test_group("ai.cyr — JSON escape (request marshalling)");
    var jb[256];
    var j1 = "a\"b\\c";                       # a " b \ c
    _ai_json_escape(j1, strlen(j1), &jb, 256);
    assert_eq(streq(&jb, "a\\\"b\\\\c"), 1, "escapes quote and backslash");
    var j2 = "x\ny";                          # x <newline> y
    _ai_json_escape(j2, strlen(j2), &jb, 256);
    assert_eq(streq(&jb, "x\\ny"), 1, "escapes newline to backslash-n");

    test_group("ai.cyr — content extraction (response parsing)");
    var cb[256];
    var resp_ok = "{\"choices\":[{\"message\":{\"content\":\"Hello\\nworld\"}}]}";
    var ce = _ai_extract_content(resp_ok, strlen(resp_ok), &cb, 256);
    assert(ce > 0, "content field found");
    assert_eq(streq(&cb, "Hello\nworld"), 1, "unescapes \\n inside content");
    var resp_err = "{\"error\":{\"message\":\"bad model\"}}";
    assert_eq(_ai_extract_content(resp_err, strlen(resp_err), &cb, 256), 0 - 1, "no content field returns -1");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
