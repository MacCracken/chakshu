# snapshot.cyr — plain-mode (`-p`) snapshot orchestration.
#
# Per design-spec §2.2: "Plain mode is sacred. -p produces a deterministic
# single-frame text dump suitable for piping into other tools." That means
# no terminal escapes, no color (unless --color=always — M2+), no tabs.
# Just printable ASCII columns terminated by \n.
#
# Slice A renders the four single-read fields on two lines:
#   host: <hostname>  up: <Nd HH:MM>  load: <L1 L5 L15>
#   mem:  <used> MiB used / <total> MiB total
#
# Slice B will append a CPU+disk+net resource line; Slice C will append
# the top-N process table. The on-screen order matches design-spec §4.

# Sleep window for the two-sample CPU/disk/net delta. 100ms per the M1
# roadmap ("computed across two samples ~100ms apart"). The M1 perf
# target of <30ms refers to parse+render work, not the sleep window —
# `watch -n 1 shu -p` will still tick comfortably within its second.
var SNAP_SAMPLE_MS = 100;

# Print n with a leading zero if n < 10. Used for HH and MM in the
# uptime "Nd HH:MM" format. Negative n is undefined (uptime never is).
fn _snap_print_pad2(n) {
    if (n < 10) { syscall(1, 1, "0", 1); }
    print_num(n);
    return 0;
}

# Format an integer bytes-per-second rate to stdout with auto-selected
# units (B/s, KiB/s, MiB/s, GiB/s). Truncates to integer at the chosen
# unit — losing sub-unit precision is fine for plain mode (the TUI
# will show one decimal at M2). Matches the design-spec §4 mockup
# style ("↓ 2.4M/s") modulo the decimal.
fn _snap_print_rate_bps(bps) {
    # R13 (v0.7.13): clamp negatives. Rates are a delta between two samples of a
    # monotonic counter, but the counter set is NOT stable across the window — an
    # interface or disk disappearing between samples makes the second total smaller
    # and the delta negative. Without this, `bps < 1024` catches the negative and
    # print_num emits a literal minus: "net: rx -8665120 B/s" on the -p contract
    # line. Single choke point: all eight *_bps values flow through here, so this
    # covers both plain mode and the TUI.
    if (bps < 0) { bps = 0; }
    if (bps < 1024) {
        print_num(bps);
        syscall(1, 1, " B/s", 4);
        return 0;
    }
    if (bps < 1048576) {                # 1024 * 1024
        print_num(bps / 1024);
        syscall(1, 1, " KiB/s", 6);
        return 0;
    }
    if (bps < 1073741824) {             # 1024 * 1024 * 1024
        print_num(bps / 1048576);
        syscall(1, 1, " MiB/s", 6);
        return 0;
    }
    print_num(bps / 1073741824);
    syscall(1, 1, " GiB/s", 6);
    return 0;
}

# Print uptime in "Nd HH:MM" form. N is unbounded (a server up for
# 400 days gets "400d HH:MM", which is the right call — truncating
# would lie about the box's age).
fn snapshot_print_uptime(secs) {
    # R17 (v0.7.13): honour the -1 sentinel this function's own contract already
    # implies. mihi_uptime_secs() returns -1 when /proc/uptime is unreadable, and
    # the arithmetic below then renders it as a confident "up: 0d 00:00" with exit
    # 0 and empty stderr — a plausible-looking lie. Handled here rather than at the
    # three call sites so plain mode and both TUI frames are fixed at once. No
    # eprint and no exit-code change: a bad uptime must not discard a good snapshot.
    if (secs < 0) { syscall(1, 1, "--d --:--", 9); return 0; }
    var days = secs / 86400;
    var rem  = secs - days * 86400;
    var hrs  = rem / 3600;
    var mins = (rem - hrs * 3600) / 60;
    print_num(days);
    syscall(1, 1, "d ", 2);
    _snap_print_pad2(hrs);
    syscall(1, 1, ":", 1);
    _snap_print_pad2(mins);
    return 0;
}

# Render the single-frame snapshot to stdout. Returns EXIT_OK on success,
# EXIT_ERR if any /proc read failed (shouldn't happen on Linux — these
# are kernel-synthesised files — but a hardened ENOENT path is one
# eprint away and surfaces real bugs early).
#
# `sort_key` is a SORT_* constant from processes.cyr; `top_n` is the
# row count for the process table. Both come from main.cyr after CLI
# flag parsing.
# Finish a snapshot on a host with no usable /proc delta sources.
#
# v0.9.3. Split out so the three "source vanished" paths in snapshot_print can
# all end the same way instead of each aborting. The process table is still
# attempted: on Linux a transiently-unreadable /proc/stat says nothing about
# /proc/<pid>, and on AGNOS the walk simply finds no pids and renders an empty
# table — which is the honest output, because agnos exposes no process
# enumeration syscall at all (getpid/spawn/waitpid/kill only). An empty table
# is information; an aborted snapshot is not.
fn snapshot_finish_no_delta(sort_key, top_n) {
    var mi[8192];
    var mem_total_b = mihi_mem_total(&mi, 8192);
    var mem_total_kb = 0;
    if (mem_total_b > 0) { mem_total_kb = mem_total_b / 1024; }
    processes_sample2(0, 1, sort_key);
    processes_render(top_n, mem_total_kb);
    return EXIT_OK;
}

fn snapshot_print(sort_key, top_n) {
    var buf[8192];

    # M2.5: hostname / kernel / uptime / meminfo / distro / cpu_model
    # all route through mihi probes. Per-frame deltas (cpu%, disk, net,
    # per-pid stats) stay chakshu-local — mihi only owns identity/static.
    var uts[400];
    mihi_uname(&uts);

    # Line 1: host + uptime + loadavg ----------------------------------
    syscall(1, 1, "host: ", 6);
    var hn = mihi_hostname(&uts);
    syscall(1, 1, hn, strlen(hn));

    syscall(1, 1, "  up: ", 6);
    snapshot_print_uptime(mihi_uptime_secs(&buf, 8192));

    syscall(1, 1, "  load: ", 8);
    # v0.9.3: a missing /proc is a DEGRADED field, not a fatal error. On AGNOS
    # there is no procfs at all — verified by booting `shu -p` under QEMU, where
    # this exact read returned -1 and took the whole snapshot down with exit 1,
    # despite the host/uptime line above it having rendered correctly from
    # mihi's uname/sysinfo. A monitor that can show four of its six fields must
    # show four, not none.
    var la_n = proc_read("/proc/loadavg", &buf, 8192);
    if (la_n < 0) {
        syscall(1, 1, "n/a", 3);
    } else {
        var la_prefix = proc_loadavg_prefix_len(&buf, la_n);
        syscall(1, 1, &buf, la_prefix);
    }
    syscall(1, 1, "\n", 1);

    # Line 2: kernel + distro ------------------------------------------
    # mihi probes return cstring pointers into the supplied scratch
    # buffer (or into the uts buffer for kernel/hostname). Capture the
    # return value rather than reading from &buf raw.
    syscall(1, 1, "kern: ", 6);
    var kn = mihi_kernel_name(&uts);
    syscall(1, 1, kn, strlen(kn));
    syscall(1, 1, " ", 1);
    var kv = mihi_kernel_version(&uts);
    syscall(1, 1, kv, strlen(kv));
    syscall(1, 1, "  distro: ", 10);
    var distro = mihi_distro(&buf, 8192);
    if (distro != 0) {
        syscall(1, 1, distro, strlen(distro));
    }
    syscall(1, 1, "\n", 1);

    # Line 3: processor identity (model + core count) -----------------
    # Named `proc:` (not `cpu:`) because the per-frame delta line below
    # also leads with `cpu:` for usage %. Plain-mode output is sacred
    # (design-spec §2.2) — downstream parsers grep on these labels.
    # mihi_cpu_model recommends 4096+ buf for /proc/cpuinfo reads;
    # reuse the 8 KiB scratch buf already on stack.
    syscall(1, 1, "proc: ", 6);
    var cpu_model = mihi_cpu_model(&buf, 8192);
    if (cpu_model != 0) {
        syscall(1, 1, cpu_model, strlen(cpu_model));
    }
    syscall(1, 1, " (", 2);
    # R18 (v0.7.13): mihi_cpu_count() returns -1 on I/O failure and 0 on a parse
    # miss; either printed verbatim yields "proc: <model> (-1 cores)" in the
    # "sacred" -p output. `> 0` covers both sentinels.
    var ncpu = mihi_cpu_count();
    if (ncpu > 0) {
        print_num(ncpu);
        syscall(1, 1, " cores)\n", 8);
    } else {
        syscall(1, 1, "unknown cores)\n", 15);
    }

    # Line 3.5: GPU / accelerators (only if present) ------------------
    # chakshu's first GPU surface. mihi probes ai-hwaccel under the
    # no-exec mask — no ROCm/CUDA processes spawned, just sysfs reads
    # and vendor-fixed-identity tables. Count == 0 → omit the line
    # entirely (most CI runners + cloud VMs); count >= 1 → one name +
    # memory per accelerator, comma-separated.
    var gpu_n = mihi_gpu_count();
    if (gpu_n > 0) {
        syscall(1, 1, "gpu:  ", 6);
        var gi = 0;
        while (gi < gpu_n) {
            if (gi > 0) { syscall(1, 1, ", ", 2); }
            var gname = mihi_gpu_name(gi);
            if (gname != 0) {
                syscall(1, 1, gname, strlen(gname));
            }
            # v0.9.1: prefer LIVE telemetry (busy%, vram used/total, temp) read
            # straight from DRM sysfs. Falls back to mihi's static capacity when
            # the driver publishes nothing — see src/gpu.cyr for which drivers do.
            var gcard = gpu_card_for(gi, gname);
            if (gpu_emit_live(gcard) == 0) {
                var gmem_b = mihi_gpu_memory_bytes(gi);
                if (gmem_b > 0) {
                    syscall(1, 1, " (", 2);
                    print_num(gmem_b / 1048576);
                    syscall(1, 1, " MiB)", 5);
                }
            }
            gi = gi + 1;
        }
        syscall(1, 1, "\n", 1);
    }

    # Line 4: memory ---------------------------------------------------
    # mihi_mem_total / mihi_mem_free both return bytes. mihi_mem_free
    # actually reads MemAvailable under the hood (preferred over true
    # MemFree for "how much can I actually use" semantics) — matches
    # chakshu's pre-M2.5 logic. processes_render still wants kB for
    # MEM% computation; keep that derivation.
    var mem_total_b = mihi_mem_total(&buf, 8192);
    var mem_avail_b = mihi_mem_free(&buf, 8192);
    var mem_total_kb  = mem_total_b / 1024;
    var mem_used_mib  = (mem_total_b - mem_avail_b) / 1048576;
    var mem_total_mib = mem_total_b / 1048576;

    # R16 (v0.7.13): mihi_mem_free() returns -1 when /proc/meminfo is
    # unreadable (and pre-3.14 kernels have no MemAvailable at all). Unguarded,
    # `mem_total_b - (-1)` renders "61192 MiB used / 61192 MiB total" — a
    # fully-consumed machine — with exit 0 and empty stderr. Degraded field, not
    # a fatal error: same posture as the uptime and core-count sentinels.
    var mem_ok = 0;
    if (mem_total_b > 0) { if (mem_avail_b >= 0) { mem_ok = 1; } }

    syscall(1, 1, "mem:  ", 6);
    if (mem_ok == 1) {
        print_num(mem_used_mib);
        syscall(1, 1, " MiB used / ", 12);
        print_num(mem_total_mib);
        syscall(1, 1, " MiB total\n", 11);
    } else {
        syscall(1, 1, "unavailable\n", 12);
    }

    # v0.9.4: buffers / cached / swap — design-spec §1 listed all three as in
    # scope from M0 and none was ever implemented. A swap meter is the second
    # thing an htop user looks for, and "used" without "cached" overstates
    # pressure badly on Linux: the page cache is reclaimable, so a box showing
    # 55 GiB used and 50 GiB cached is not under memory pressure at all.
    #
    # ⚠ Read ONCE into the shared buffer and pull four fields, rather than four
    # reads. /proc/meminfo is ~50 lines and re-reading it per field is the kind of
    # avoidable syscall cost the §8 budget is measured against.
    var mi_n = proc_read("/proc/meminfo", &buf, 8192);
    if (mi_n > 0) {
        var buffers_kb = proc_meminfo_field(&buf, "Buffers:");
        var cached_kb  = proc_meminfo_field(&buf, "Cached:");
        var swtot_kb   = proc_meminfo_field(&buf, "SwapTotal:");
        var swfree_kb  = proc_meminfo_field(&buf, "SwapFree:");

        syscall(1, 1, "      buff ", 11);
        print_num(buffers_kb / 1024);
        syscall(1, 1, " MiB / cache ", 13);
        print_num(cached_kb / 1024);
        syscall(1, 1, " MiB\n", 5);

        syscall(1, 1, "swap: ", 6);
        if (swtot_kb > 0) {
            print_num((swtot_kb - swfree_kb) / 1024);
            syscall(1, 1, " MiB used / ", 12);
            print_num(swtot_kb / 1024);
            syscall(1, 1, " MiB total\n", 11);
        } else {
            # Zero SwapTotal is a real, common configuration, not a read failure.
            # Say so rather than printing "0 MiB / 0 MiB", which reads like a bug.
            syscall(1, 1, "none configured\n", 16);
        }
    }

    # Line 3: cpu + disk + net (delta-based) ---------------------------
    # Sample 1
    # R7c (v0.7.13): 64 KiB heap scratch, allocated once, instead of 8 KiB
    # stack locals — /proc/net/dev and /proc/stat both overflow 8 KiB on hosts
    # with many interfaces or many cores, and the overflow was silent.
    proc_truncated_reset();
    var sb1 = proc_scratch(0);
    var db1 = proc_scratch(1);
    var nb1 = proc_scratch(2);
    var s1n = proc_read("/proc/stat",      sb1, PROC_BUF_CAP);
    var d1n = proc_read("/proc/diskstats", db1, PROC_BUF_CAP);
    var n1n = proc_read("/proc/net/dev",   nb1, PROC_BUF_CAP);
    # v0.9.3: same posture as the load field. Where there is no procfs the
    # delta line simply cannot be computed, and printing "n/a" beats aborting a
    # snapshot whose identity and memory lines are perfectly good. Each source
    # is independent, so a host missing only one of them still shows the rest.
    var have_delta = 1;
    if (s1n < 0) { have_delta = 0; }
    if (d1n < 0) { have_delta = 0; }
    if (n1n < 0) { have_delta = 0; }
    if (have_delta == 0) {
        syscall(1, 1, "cpu:  n/a   disk: n/a   net: n/a\n", 33);
        return snapshot_finish_no_delta(sort_key, top_n);
    }

    var cpu_active1 = 0;
    var cpu_total1  = 0;
    var sec_r1 = 0;
    var sec_w1 = 0;
    var rx1 = 0;
    var tx1 = 0;
    proc_stat_cpu_agg (sb1, &cpu_active1, &cpu_total1);
    proc_diskstats_agg(db1, d1n, &sec_r1, &sec_w1);
    proc_netdev_agg   (nb1, n1n, &rx1, &tx1);
    var ncores = proc_stat_ncores(sb1, s1n);

    # Slice C — sample 1 of /proc/[pid]/stat (utime+stime per pid).
    # Same 100ms window as the aggregate cpu/disk/net sampling, so the
    # per-process CPU% sums correlate with the aggregate cpu line.
    processes_sample1();

    sleep_ms(SNAP_SAMPLE_MS);

    # Sample 2 (reuse the same buffers — sample 1's parsed ints are safe)
    var s2n = proc_read("/proc/stat",      sb1, PROC_BUF_CAP);
    var d2n = proc_read("/proc/diskstats", db1, PROC_BUF_CAP);
    var n2n = proc_read("/proc/net/dev",   nb1, PROC_BUF_CAP);
    # R22 (v0.7.13): these three hand-counted lengths were each one short (42/47/45
    # vs 43/48/46), silently truncating the trailing newline off the diagnostic —
    # a design-spec §9 violation, and the same hand-counting trap cli.cyr already
    # warns has "bitten us twice". eprintln() computes the length with strlen().
    # A source that vanished BETWEEN the two samples (a rotated file, an
    # unmounted procfs) is the same degraded case, not a fatal one.
    if (s2n < 0) { syscall(1, 1, "cpu:  n/a   disk: n/a   net: n/a\n", 33); return snapshot_finish_no_delta(sort_key, top_n); }
    if (d2n < 0) { syscall(1, 1, "cpu:  n/a   disk: n/a   net: n/a\n", 33); return snapshot_finish_no_delta(sort_key, top_n); }
    if (n2n < 0) { syscall(1, 1, "cpu:  n/a   disk: n/a   net: n/a\n", 33); return snapshot_finish_no_delta(sort_key, top_n); }

    var cpu_active2 = 0;
    var cpu_total2  = 0;
    var sec_r2 = 0;
    var sec_w2 = 0;
    var rx2 = 0;
    var tx2 = 0;
    proc_stat_cpu_agg (sb1, &cpu_active2, &cpu_total2);
    proc_diskstats_agg(db1, d2n, &sec_r2, &sec_w2);
    proc_netdev_agg   (nb1, n2n, &rx2, &tx2);

    # CPU% = 100 * active_delta / total_delta. Guard div-by-zero on the
    # off-chance both samples capture the exact same tick (USER_HZ is
    # typically 100, so a 100ms window yields ~10 ticks — non-zero in
    # practice, but defensive).
    var cpu_pct = 0;
    var total_delta = cpu_total2 - cpu_total1;
    if (total_delta > 0) {
        cpu_pct = (cpu_active2 - cpu_active1) * 100 / total_delta;
    }

    # Sectors → bytes (×512), then bytes/sample-window → bytes/sec
    # (×1000/SNAP_SAMPLE_MS). For the 100ms default, that's ×5120.
    var disk_rd_bps = (sec_r2 - sec_r1) * 512 * 1000 / SNAP_SAMPLE_MS;
    var disk_wr_bps = (sec_w2 - sec_w1) * 512 * 1000 / SNAP_SAMPLE_MS;
    var net_rx_bps  = (rx2 - rx1) * 1000 / SNAP_SAMPLE_MS;
    var net_tx_bps  = (tx2 - tx1) * 1000 / SNAP_SAMPLE_MS;

    syscall(1, 1, "cpu:  ", 6);
    print_num(cpu_pct);
    syscall(1, 1, "%   disk: rd ", 13);
    _snap_print_rate_bps(disk_rd_bps);
    syscall(1, 1, " wr ", 4);
    _snap_print_rate_bps(disk_wr_bps);
    syscall(1, 1, "   net: rx ", 11);
    _snap_print_rate_bps(net_rx_bps);
    syscall(1, 1, " tx ", 4);
    _snap_print_rate_bps(net_tx_bps);
    syscall(1, 1, "\n", 1);

    # Slice C — process table. Sample 2 needs the aggregate cpu_total
    # delta (already computed) and the core count (parsed from sample
    # 1's stat buffer above). Sort key + top-N come from CLI flags
    # parsed in main.cyr.
    processes_sample2(total_delta, ncores, sort_key);
    processes_render(top_n, mem_total_kb);

    return EXIT_OK;
}
