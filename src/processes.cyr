# processes.cyr — /proc/[pid] walker, two-sample CPU sampling, sort,
# and top-N table render. Slice C of the M1 plain-snapshot arc.
#
# Per-process record layout (48 bytes; an array of these lives at
# _proc_recs, sized PROC_MAX records):
#
#   off  0  pid           u64
#   off  8  cpu_pct       u64 (htop convention — per-core × 100 max)
#   off 16  rss           u64 (pages; ×4096 = bytes on x86_64/aarch64)
#   off 24  state         u64 (low byte = ASCII state char R/S/D/Z/T)
#   off 32  comm[16]      bytes (TASK_COMM_LEN, null-terminated)
#
# Sampling: sample 1 captures (pid → utime+stime) in a u64 hashmap;
# sample 2 walks /proc again and computes the per-process tick delta
# against the map. Processes that exited between samples are absent;
# processes that exec'd between samples are present with cpu_pct=0
# (no sample-1 baseline → delta math returns the full sample-2 ticks
# which we discard via map_u64_get_or default == ticks2).
#
# cmdline isn't read here — it's per-line work that dwarfs the per-pid
# stat parse and only matters for the displayed top-N. Slice D will
# read cmdline for the post-sort top-N rather than every pid.

# v0.9.5: 48 -> 56. The record was exactly full — pid/cpu/rss/state at +0..+31 and
# comm at +32..+47 — so the USER column needed one more slot: uid at +48.
var PROC_REC_SIZE      = 56;
# R5 (v0.7.13 P-1 sweep): raised 1024 -> 8192. The walk below breaks at
# PROC_MAX *before* the sort runs, so on a host with more than PROC_MAX
# processes the busiest one was simply absent from the table — the monitor
# silently omitted exactly what it exists to show (reproduced on a 1197-proc
# box: a 103%-CPU burner missing from `-p --top 5`, three of five rows being
# 0% kernel threads). 8192 is a HARD ceiling, coupled to _tui_filtered_idx in
# src/tui.cyr, which is a module-scope array of exactly 8192 u64 slots and is
# indexed without a bounds check. Raise both together or neither.
var PROC_MAX           = 8192;
# Name arena for the /proc directory scan (R4). 16 bytes/entry average is
# generous: pid names are <= 7 chars, and the longest non-pid entry in /proc
# ("thread-self") is 11.
var PROC_NAMES_CAP     = 131072;
var PROC_DEFAULT_TOPN  = 10;

# Sort-key constants for processes_sample2 / _proc_cmp.
var SORT_CPU  = 0;   # cpu_pct desc — default
var SORT_MEM  = 1;   # rss desc
var SORT_PID  = 2;   # pid asc
var SORT_NAME = 3;   # comm asc (lexicographic)
var SORT_USER = 4;   # username asc then pid — design-spec §1, shipped v0.9.5

# Cmdline display cap. /proc/[pid]/cmdline can be ARG_MAX (2 MB) but
# the displayed line wants to fit comfortably in a typical terminal /
# pipe. 256 bytes covers ~99% of real cmdlines; longer ones truncate.
var PROC_CMDLINE_MAX = 256;

# Lazy module globals — alloc'd on first sample, reused across calls.
var _proc_recs  = 0;
var _proc_n     = 0;
var _proc_map   = 0;
# Second tick map, for the TUI's single-walk delta path. `_proc_map` holds the
# PREVIOUS frame's ticks while `_proc_map_b` accumulates this frame's; the two
# swap at the end of every sample so the baseline is always exactly one frame
# old and dead pids age out instead of accumulating. See
# processes_sample_delta().
var _proc_map_b = 0;
# R4 (v0.7.13): preallocated once, reused every frame. See _proc_scan_pids.
var _proc_names = 0;
var _proc_offs  = 0;
var _proc_dir   = 0;

fn _proc_ensure_init() {
    if (_proc_recs == 0) {
        _proc_recs = alloc(PROC_MAX * PROC_REC_SIZE);
    }
    if (_proc_map == 0) {
        _proc_map = map_u64_new();
    }
    if (_proc_map_b == 0) {
        _proc_map_b = map_u64_new();
    }
    if (_proc_names == 0) {
        _proc_names = alloc(PROC_NAMES_CAP);
    }
    if (_proc_offs == 0) {
        _proc_offs = alloc(PROC_MAX * 8);
    }
    if (_proc_dir == 0) {
        # str_from() allocates a 16-byte Str header per call; hoisted so the
        # two per-frame calls stop leaking one each.
        _proc_dir = str_from("/proc");
    }
    return 0;
}

# Scan /proc into the preallocated name arena. Returns the entry count.
#
# R4 (v0.7.13): this replaces two per-frame `dir_list()` calls. dir_list
# str_clone()s every entry out of a Vec, and cyrius's allocator is a bump
# allocator with no free — so the TUI leaked ~44 KB per frame at 1 Hz, taking
# RSS from 4.5 MB to 12.7 MB in 200 s and breaching design-spec Section 8's
# 8 MB budget in about 90 seconds of ordinary use. dir_list_into() writes into
# caller-owned memory and allocates nothing.
fn _proc_scan_pids() {
    _proc_ensure_init();
    var scratch[4096];
    var rc = dir_list_into(_proc_dir, &scratch, 4096, _proc_names, PROC_NAMES_CAP,
      _proc_offs, PROC_MAX);
    if (rc >= 0) { return rc; }
    # Clamp fallback. dir_list_into bails on the FIRST overflow and discards
    # its running count, so returning rc here would render an EMPTY process
    # table — strictly worse than the truncated-but-populated table we have
    # today. Degrade to the allocating dir_list and copy in what fits.
    # Deliberately near-unreachable: PROC_MAX 8192 and a 128 KB arena sit far
    # above any real /proc, so the leaky path is a safety net, not a mode.
    var entries = dir_list(_proc_dir);
    var count = 0;
    var npos  = 0;
    var i = 0;
    while (i < vec_len(entries)) {
        if (count >= PROC_MAX) { break; }
        var nm   = str_data(vec_get(entries, i));
        var nlen = strlen(nm);
        if (npos + nlen + 1 > PROC_NAMES_CAP) { break; }
        store64(_proc_offs + count * 8, npos);
        memcpy(_proc_names + npos, nm, nlen);
        store8(_proc_names + npos + nlen, 0);
        npos  = npos + nlen + 1;
        count = count + 1;
        i = i + 1;
    }
    return count;
}

# Sample 1 — populate _proc_map[pid] = utime+stime.
# Owning (real) uid for a pid, or 0 when it cannot be read.
#
# ⚠ A SECOND per-pid read, which this file's header warns against for cmdline
# ("per-line work that dwarfs the per-pid stat parse"). MEASURED, and the warning
# was right: reading it for every pid took the TUI from 0.500% to **0.866%** of a
# core at 1 Hz on a 289-process box — a 73% rise that blows design-spec §8's
# `< 0.5%` budget outright.
#
# So it is read for every pid ONLY when sorting by user, where a sort key must be
# known for every row. On every other sort the record carries -1 and the name is
# resolved lazily for the displayed top-N — the same trick this file already uses
# for cmdline, and the cost falls to ~10 reads per frame instead of ~289.
# The column is never faked: an unresolvable uid renders as its number.
fn _proc_read_uid(pid_str) {
    var upath[64];
    proc_pid_path(pid_str, "/status", &upath);
    var ub[1024];
    var un = file_read_all(&upath, &ub, 1023);
    if (un <= 0) { return 0; }
    store8(&ub + un, 0);
    # "Uid:\t<real>\t<eff>\t<saved>\t<fs>" — the REAL uid is first and is what
    # ps/htop show. proc_line_field is line-anchored (R10), so a process renamed
    # to "Uid:0" via prctl cannot plant a match inside its own Name: line.
    return proc_line_field(&ub, "Uid:");
}

fn processes_sample1() {
    _proc_ensure_init();
    #ifdef CYRIUS_TARGET_AGNOS
    # No CPU-tick baseline to seed: proclist carries no per-process cpu time,
    # so the two-sample delta the Linux path needs has nothing to sample.
    return 0;
    #endif
    map_u64_clear(_proc_map);
    var scanned = _proc_scan_pids();
    var i = 0;
    while (i < scanned) {
        var name = _proc_names + load64(_proc_offs + i * 8);
        if (proc_is_pid_name(name) == 1) {
            var pid = atoi(name);
            var path[64];
            proc_pid_path(name, "/stat", &path);
            var sb[1024];
            var sn = file_read_all(&path, &sb, 1023);
            if (sn > 0) {
                store8(&sb + sn, 0);
                var srec[48];
                if (proc_pid_stat_parse(&sb, sn, &srec) == 0) {
                    map_u64_set(_proc_map, pid, load64(&srec + 8));
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

# Lexicographic comparator for two 16-byte comm cstrings. Returns
# positive if a < b alphabetically, negative if a > b, 0 if equal.
# Stops at the first null in either string (TASK_COMM_LEN-padded).
fn _proc_cmp_comm(a, b) {
    var i = 0;
    while (i < 16) {
        var ca = load8(a + i);
        var cb = load8(b + i);
        if (ca < cb) { return 1; }
        if (ca > cb) { return 0 - 1; }
        if (ca == 0) { return 0; }
        i = i + 1;
    }
    return 0;
}

# Returns positive if record `a` should sort before record `b` under
# `sort_key`. Used by the insertion sort loop. Default sort directions:
# CPU/MEM descending (highest first), PID/NAME ascending.
fn _proc_cmp(a, b, sort_key) {
    if (sort_key == SORT_CPU)  { return load64(a + 8)  - load64(b + 8); }
    if (sort_key == SORT_MEM)  { return load64(a + 16) - load64(b + 16); }
    if (sort_key == SORT_PID)  { return load64(b + 0)  - load64(a + 0); }
    if (sort_key == SORT_NAME) { return _proc_cmp_comm(a + 32, b + 32); }
    if (sort_key == SORT_USER) {
        # Sort by the RESOLVED NAME, not the uid: the column shows names, and a
        # table ordered by a number the reader cannot see looks unsorted. Ties —
        # the common case, since most rows share one owner — fall back to pid so
        # the order is stable rather than arbitrary.
        var na[24];
        var nb[24];
        users_name_for(load64(a + 48), &na, 24);
        users_name_for(load64(b + 48), &nb, 24);
        var uc = _proc_cmp_comm(&na, &nb);
        if (uc != 0) { return uc; }
        return load64(b + 0) - load64(a + 0);
    }
    return 0;
}

# Sample 2 — walk /proc, compute cpu_pct from delta against sample 1,
# append per-pid record, then sort by `sort_key`. Top-N selection
# happens in processes_render so callers can change top-N without
# re-walking /proc.
# Sort the sampled table in place under `sort_key`. Shared by the two-walk
# sampler (`shu -p`) and the single-walk TUI sampler.
fn _proc_sort(sort_key) {
    # Insertion sort under the chosen comparator, shift-hole form.
    #
    # R6 (v0.7.13): the previous version swapped adjacent records with THREE
    # memcpy(48) calls per shift step, and lib/string.cyr's memcpy is a byte
    # loop — so every step moved 144 bytes one at a time. Lifting the record
    # into a hole once and shifting predecessors up costs one memcpy per step
    # plus two for the lift/drop: ~2.85x faster, measured. This matters far
    # more now that R5 raised PROC_MAX to 8192, where the old form cost
    # roughly 1.5 s on `--sort mem`.
    #
    # Output is byte-identical and stability is preserved: the strict `> 0`
    # test means equal records never shift past one another.
    var s = 1;
    while (s < _proc_n) {
        var tmp[48];
        memcpy(&tmp, _proc_recs + s * PROC_REC_SIZE, PROC_REC_SIZE);
        var j = s;
        while (j > 0) {
            var prev = _proc_recs + (j - 1) * PROC_REC_SIZE;
            if (_proc_cmp(&tmp, prev, sort_key) > 0) {
                memcpy(_proc_recs + j * PROC_REC_SIZE, prev, PROC_REC_SIZE);
                j = j - 1;
            } else {
                break;
            }
        }
        memcpy(_proc_recs + j * PROC_REC_SIZE, &tmp, PROC_REC_SIZE);
        s = s + 1;
    }
    return 0;
}

# Single-walk sampler for the TUI (v0.7.15).
#
# processes_sample1() + processes_sample2() is a TWO-walk pattern: seed the tick
# map, sleep, walk again, difference. That is right for `shu -p`, which is a
# one-shot snapshot with no earlier frame to difference against. In the TUI it
# was pure waste — every frame paid two full /proc walks (~562 per-pid stat
# reads/sec at 1 Hz with 281 processes) plus a 100 ms sleep, to measure a
# 100 ms window inside a 1000 ms refresh interval.
#
# This variant walks ONCE and differences against the previous frame, recording
# the current ticks as it goes. Two maps rather than one in-place update: if we
# overwrote `_proc_map` while reading it we would lose the baseline mid-walk,
# and a single map never sheds entries for pids that have exited — with pid
# reuse a stale entry becomes a wrong baseline. Swapping a freshly-built map in
# each frame bounds it exactly to the live set.
#
# `total_delta` is the aggregate CPU-tick delta over the SAME window the caller
# used, so per-pid percentages stay consistent with the summary line.
fn processes_sample_delta(total_delta, ncores, sort_key) {
    _proc_ensure_init();
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos has no procfs; the table comes from proclist #99 in one shot.
    # total_delta/ncores are meaningless without per-process cpu time.
    _procs_fill_agnos(sort_key);
    return 0;
    #endif
    map_u64_clear(_proc_map_b);
    _proc_n = 0;
    var scanned = _proc_scan_pids();
    var i = 0;
    while (i < scanned) {
        if (_proc_n >= PROC_MAX) { break; }
        var name = _proc_names + load64(_proc_offs + i * 8);
        if (proc_is_pid_name(name) == 1) {
            var pid = atoi(name);
            var path[64];
            proc_pid_path(name, "/stat", &path);
            var sb[1024];
            var sn = file_read_all(&path, &sb, 1023);
            if (sn > 0) {
                store8(&sb + sn, 0);
                var srec[48];
                if (proc_pid_stat_parse(&sb, sn, &srec) == 0) {
                    var ticks2 = load64(&srec + 8);
                    # Default to ticks2 so a pid first seen this frame yields a
                    # delta of 0 rather than its whole lifetime's CPU.
                    var ticks1 = map_u64_get_or(_proc_map, pid, ticks2);
                    map_u64_set(_proc_map_b, pid, ticks2);
                    var dt = ticks2 - ticks1;
                    if (dt < 0) { dt = 0; }
                    var cpu_pct = 0;
                    if (total_delta > 0) {
                        cpu_pct = dt * 100 * ncores / total_delta;
                    }
                    var rec = _proc_recs + _proc_n * PROC_REC_SIZE;
                    store64(rec + 0,  pid);
                    store64(rec + 8,  cpu_pct);
                    store64(rec + 16, load64(&srec + 16));
                    store64(rec + 24, load64(&srec + 0));
                    memcpy(rec + 32, &srec + 24, 16);
                    var uidv = 0 - 1;                       # -1 = unread sentinel
                    if (sort_key == SORT_USER) { uidv = _proc_read_uid(name); }
                    store64(rec + 48, uidv);
                    _proc_n = _proc_n + 1;
                }
            }
        }
        i = i + 1;
    }

    # Swap: this frame's map becomes next frame's baseline.
    var tmp = _proc_map;
    _proc_map   = _proc_map_b;
    _proc_map_b = tmp;

    _proc_sort(sort_key);
    return 0;
}

fn processes_sample2(total_delta, ncores, sort_key) {
    _proc_n = 0;
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos has no procfs; the table comes from proclist #99 in one shot.
    # total_delta/ncores are meaningless without per-process cpu time.
    _procs_fill_agnos(sort_key);
    return 0;
    #endif
    # R4: _proc_scan_pids() also calls _proc_ensure_init(), which sample2
    # previously never did — it relied on sample1 having run first.
    var scanned = _proc_scan_pids();
    var i = 0;
    while (i < scanned) {
        if (_proc_n >= PROC_MAX) { break; }
        var name = _proc_names + load64(_proc_offs + i * 8);
        if (proc_is_pid_name(name) == 1) {
            var pid = atoi(name);
            var path[64];
            proc_pid_path(name, "/stat", &path);
            var sb[1024];
            var sn = file_read_all(&path, &sb, 1023);
            if (sn > 0) {
                store8(&sb + sn, 0);
                var srec[48];
                if (proc_pid_stat_parse(&sb, sn, &srec) == 0) {
                    var ticks2 = load64(&srec + 8);
                    # Default to ticks2 so unmapped pids (new since
                    # sample 1) yield a delta of 0, not a huge number.
                    var ticks1 = map_u64_get_or(_proc_map, pid, ticks2);
                    var dt = ticks2 - ticks1;
                    if (dt < 0) { dt = 0; }
                    var cpu_pct = 0;
                    if (total_delta > 0) {
                        cpu_pct = dt * 100 * ncores / total_delta;
                    }
                    var rec = _proc_recs + _proc_n * PROC_REC_SIZE;
                    store64(rec + 0,  pid);
                    store64(rec + 8,  cpu_pct);
                    store64(rec + 16, load64(&srec + 16));
                    store64(rec + 24, load64(&srec + 0));
                    memcpy(rec + 32, &srec + 24, 16);
                    var uidv = 0 - 1;                       # -1 = unread sentinel
                    if (sort_key == SORT_USER) { uidv = _proc_read_uid(name); }
                    store64(rec + 48, uidv);
                    _proc_n = _proc_n + 1;
                }
            }
        }
        i = i + 1;
    }

    _proc_sort(sort_key);
    return 0;
}

# Convert non-negative integer to a null-terminated decimal cstring
# in `buf`. Returns byte length (excl null). Caller's buf must be at
# least 24 bytes (max i64 = 19 digits + sign + null + slack).
# Used to build /proc/<pid>/cmdline paths from numeric pids.
fn _proc_int_to_cstr(n, buf) {
    var pbuf[24];
    var pi = 23;
    if (n == 0) { store8(&pbuf + pi, 48); pi = pi - 1; }
    while (n > 0) {
        store8(&pbuf + pi, 48 + n % 10);
        pi = pi - 1;
        n = n / 10;
    }
    var len = 23 - pi;
    var ci = 0;
    while (ci < len) {
        store8(buf + ci, load8(&pbuf + pi + 1 + ci));
        ci = ci + 1;
    }
    store8(buf + len, 0);
    return len;
}

# Read /proc/<pid>/cmdline, replace null separators with spaces, trim
# trailing whitespace, null-terminate. Returns bytes (excl null), or 0
# for kernel threads (empty cmdline) and unreadable cases. Caller falls
# back to a bracketed `comm` for the kernel-thread case.
fn _proc_read_cmdline(pid_str, out_buf, max_len) {
    var path[64];
    proc_pid_path(pid_str, "/cmdline", &path);
    var n = file_read_all(&path, out_buf, max_len - 1);
    if (n <= 0) { return 0; }
    # Scrub control bytes. /proc/<pid>/cmdline is FULLY attacker-controlled —
    # any unprivileged process can rewrite its own argv — so a raw copy lets it
    # inject ANSI escapes into the terminal and forge extra table rows with an
    # embedded newline (design-spec §2: plain mode emits no terminfo escapes).
    # NUL first: it is argv's separator and must become a space, not '?', or the
    # tokens collapse and the AI redaction pass stops seeing argument boundaries.
    # Every other C0 byte and DEL becomes '?'. Bytes >= 0x80 pass through (UTF-8).
    var i = 0;
    while (i < n) {
        var c = load8(out_buf + i);
        if (c == 0) { store8(out_buf + i, 32); }
        elif (c < 32) { store8(out_buf + i, 63); }
        elif (c == 127) { store8(out_buf + i, 63); }
        i = i + 1;
    }
    while (n > 0) {
        if (load8(out_buf + n - 1) != 32) { break; }
        n = n - 1;
    }
    store8(out_buf + n, 0);
    return n;
}

# Print integer right-aligned in `width` columns. width must be >=
# decimal-digits-of-n; otherwise the number prints unpadded (no
# truncation — better to overflow the column than lie about the
# value).
# Right-align "n/a" in `width` columns. Used where the kernel does not track a
# value at all — a measured 0 and an untracked value are different facts, and a
# monitor that prints 0 for the second is inventing data. On Linux nothing ever
# reaches this: every value below is >= 0 there, so the branch is inert.
fn _proc_print_na_pad(width) {
    var sp = width - 3;
    while (sp > 0) {
        syscall(1, 1, " ", 1);
        sp = sp - 1;
    }
    syscall(1, 1, "n/a", 3);
    return 0;
}

fn _proc_print_int_pad(n, width) {
    var w = 1;
    var x = n;
    while (x >= 10) { w = w + 1; x = x / 10; }
    var sp = width - w;
    while (sp > 0) {
        syscall(1, 1, " ", 1);
        sp = sp - 1;
    }
    print_num(n);
    return 0;
}

# Owning uid for a record, reading it now if the sampler skipped it.
#
# The sampler only pays the per-pid /status read when sorting by user; every other
# sort leaves -1 here and this resolves the handful of rows actually displayed.
# Callers must go through this rather than loading +48 directly, or a row will
# render its owner as "-1".
fn proc_rec_uid(rec) {
    var u = load64(rec + 48);
    if (u >= 0) { return u; }
    #ifdef CYRIUS_TARGET_AGNOS
    # There is no /proc/<pid>/status to fall back to, and proclist has no uid
    # field, so -1 is final rather than "not read yet".
    return 0 - 1;
    #endif
    var pbuf[24];
    _proc_int_to_cstr(load64(rec + 0), &pbuf);
    u = _proc_read_uid(&pbuf);
    store64(rec + 48, u);                       # memoise for this frame
    return u;
}

# Render the top-N rows of the sorted process table to stdout. Layout:
#
#      PID USER      S  CPU%  MEM% CMD
#    1234 macro     R    18     3 firefox
#     892 root      S     6     1 Web Content
#
# v0.9.5: USER added — design-spec §1 listed sort/filter by user as in scope from
# M0 and there was no column at all. It sits second because that is where htop and
# ps put it, and a migrating user reads left-to-right.
# Right-align numeric columns; left-align USER and CMD with one trailing space.
# mem_pct = rss_pages × 4096 × 100 / (mem_total_kb × 1024) simplifies
# to rss × 400 / mem_total_kb (integer truncation; sub-1% reads as 0).
fn processes_render(top_n, mem_total_kb) {
    syscall(1, 1, "   PID USER      S  CPU%  MEM% CMD\n", 35);
    var n = _proc_n;
    if (n > top_n) { n = top_n; }
    var i = 0;
    while (i < n) {
        var rec = _proc_recs + i * PROC_REC_SIZE;
        var pid = load64(rec + 0);
        var cpu = load64(rec + 8);
        var rss = load64(rec + 16);
        var st  = load64(rec + 24);
        var mem = 0;
        if (rss < 0) {
            mem = 0 - 1;                        # untracked -> propagate, don't zero
        } else {
            if (mem_total_kb > 0) {
                mem = rss * 400 / mem_total_kb;
            }
        }
        _proc_print_int_pad(pid, 6);
        syscall(1, 1, " ", 1);
        # USER, left-aligned in a 9-wide column. Names longer than that are
        # CLIPPED rather than widening the row: the column budget belongs to CMD,
        # which is the field a reader actually scans, and 9 covers the overwhelming
        # majority of real account names.
        var unm[24];
        var uidv = proc_rec_uid(rec);
        var ul = 3;
        if (uidv < 0) {
            # No owner is knowable (agnos: proclist carries no uid field).
            store8(&unm, 110); store8(&unm + 1, 47); store8(&unm + 2, 97);
            store8(&unm + 3, 0);
        } else {
            ul = users_name_for(uidv, &unm, 24);
        }
        if (ul > 9) { ul = 9; }
        syscall(1, 1, &unm, ul);
        var upad = 9 - ul;
        while (upad > 0) { syscall(1, 1, " ", 1); upad = upad - 1; }
        syscall(1, 1, " ", 1);
        var sc[2];
        store8(&sc, st);
        store8(&sc + 1, 0);
        syscall(1, 1, &sc, 1);
        if (cpu < 0) { _proc_print_na_pad(6); } else { _proc_print_int_pad(cpu, 6); }
        if (mem < 0) { _proc_print_na_pad(6); } else { _proc_print_int_pad(mem, 6); }
        syscall(1, 1, " ", 1);
        # CMD: prefer /proc/<pid>/cmdline (full command line, joined
        # by spaces). Kernel threads have empty cmdline — fall back to
        # the TASK_COMM_LEN comm in brackets, matching htop convention.
        var pid_str[24];
        _proc_int_to_cstr(pid, &pid_str);
        var cmd_buf[256];
        var cmd_n = _proc_read_cmdline(&pid_str, &cmd_buf, PROC_CMDLINE_MAX);
        if (cmd_n > 0) {
            syscall(1, 1, &cmd_buf, cmd_n);
        } else {
            # No cmdline. On Linux that means a kernel thread and comm is always
            # set, so the bracketed comm is the htop convention. On agnos a slot
            # the ELF loader never named (pid 0, the idle task) has an EMPTY comm
            # too, and "[]" reads as a truncation bug rather than as an absent
            # name — so say n/a, the same word the untracked columns use.
            var cl = strlen(rec + 32);
            syscall(1, 1, "[", 1);
            if (cl > 0) {
                syscall(1, 1, rec + 32, cl);
            } else {
                syscall(1, 1, "n/a", 3);
            }
            syscall(1, 1, "]", 1);
        }
        syscall(1, 1, "\n", 1);
        i = i + 1;
    }
    return 0;
}

# --- cmdline cache (v0.9.0) -------------------------------------------
#
# The TUI reads /proc/<pid>/cmdline for every VISIBLE row, every frame — on an
# 80x24 terminal that is ~18 open/read/close trios per second on top of the
# per-pid stat walk. Measured over a 60 s window at 1 Hz: the full table costs
# 0.517% of one core against design-spec §8's < 0.5% target, while `--top 1`
# (which renders one row, so one cmdline read) costs 0.467%. The gap IS the
# per-row cmdline read.
#
# A cmdline only changes when the process execs, so re-reading it every second
# is pure waste. This is a direct-mapped cache: 64 slots indexed by pid % 64,
# each holding the pid, the comm it was captured with, and the text.
#
# INVALIDATION is the interesting part. Keying on pid alone would serve a stale
# cmdline after an exec, and pid reuse would serve one belonging to a different
# process entirely. So a hit requires pid AND comm to match — exec almost always
# changes comm, and pid reuse essentially always does — plus an age bound, so
# even an exec that somehow preserved comm self-corrects within
# PROC_CMD_REFRESH frames rather than persisting for the session.
#
# 64 slots x 256 bytes = 16,384 bytes of .bss, under the 65,536-byte CI gate.
# A collision just costs a re-read, which is exactly today's behaviour.
var PROC_CMD_SLOTS   = 64;
var PROC_CMD_TEXT    = 256;
var PROC_CMD_REFRESH = 30;      # frames; ~30 s at the default 1 Hz
var _proc_cmd_text[2048];       # 64 * 256 bytes
var _proc_cmd_pid[64];
var _proc_cmd_comm[512];        # 64 * 8 bytes of comm prefix, as an i64 tag
var _proc_cmd_age[64];
var _proc_cmd_gen = 0;
var _proc_cmd_ready = 0;

# Advance the frame counter. Called once per rendered frame.
fn proc_cmdline_tick() {
    _proc_cmd_gen = _proc_cmd_gen + 1;
    return 0;
}

# Fold the first 8 bytes of a comm into an i64 tag. comm is capped at 15 bytes
# by the kernel and the leading bytes are what distinguish an exec in practice;
# a full compare would cost more than the read this cache exists to avoid.
fn _proc_comm_tag(comm) {
    var t = 0;
    var i = 0;
    while (i < 8) {
        var c = load8(comm + i);
        if (c == 0) { break; }
        t = t * 131 + c;
        i = i + 1;
    }
    return t;
}

fn _proc_cmd_init() {
    if (_proc_cmd_ready == 1) { return 0; }
    var i = 0;
    while (i < PROC_CMD_SLOTS) {
        store64(&_proc_cmd_pid + i * 8, 0);
        store64(&_proc_cmd_comm + i * 8, 0);
        store64(&_proc_cmd_age + i * 8, 0);
        i = i + 1;
    }
    _proc_cmd_ready = 1;
    return 0;
}

# Cached form of _proc_read_cmdline for the render path. `comm` is the comm from
# THIS frame's sample, which is what makes exec/pid-reuse detectable. Returns
# the byte length written to out_buf, exactly like the uncached call.
fn proc_read_cmdline_cached(pid_str, pid, comm, out_buf, max_len) {
    _proc_cmd_init();
    var slot = pid % PROC_CMD_SLOTS;
    var tag  = _proc_comm_tag(comm);
    var slot_text = &_proc_cmd_text + slot * PROC_CMD_TEXT;

    var hit = 0;
    if (load64(&_proc_cmd_pid + slot * 8) == pid) {
        if (load64(&_proc_cmd_comm + slot * 8) == tag) {
            if (_proc_cmd_gen - load64(&_proc_cmd_age + slot * 8) < PROC_CMD_REFRESH) {
                hit = 1;
            }
        }
    }

    if (hit == 0) {
        var n = _proc_read_cmdline(pid_str, slot_text, PROC_CMD_TEXT);
        store8(slot_text + n, 0);
        store64(&_proc_cmd_pid + slot * 8, pid);
        store64(&_proc_cmd_comm + slot * 8, tag);
        store64(&_proc_cmd_age + slot * 8, _proc_cmd_gen);
    }

    var len = strlen(slot_text);
    if (len > max_len - 1) { len = max_len - 1; }
    var k = 0;
    while (k < len) {
        store8(out_buf + k, load8(slot_text + k));
        k = k + 1;
    }
    store8(out_buf + len, 0);
    return len;
}

# Drop every cached entry. Used when the sort or filter changes the visible set
# wholesale, and by tests.
fn proc_cmdline_cache_reset() {
    _proc_cmd_ready = 0;
    _proc_cmd_gen = 0;
    return 0;
}
