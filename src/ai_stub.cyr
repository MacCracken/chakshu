# ai_stub.cyr — lean-build stand-in for src/ai.cyr.
#
# The default `shu` binary is the monitor only: it does NOT link the AI
# transport (sandhi) or the redaction engine (niyama), which together add
# ~1.7 MB. `--explain` (and the TUI `?` key) resolve to this stub, which
# points the user at the `shu-ai` build. The real implementation lives in
# src/ai.cyr and is linked only by ai/main.cyr → `shu-ai`.
#
# Keep this in signature-sync with the entry points cli.cyr / tui.cyr call:
# only ai_explain(pid) is referenced from the shared CLI path today.

# 0: this is the lean build. src/cli_parse.cyr refuses --explain and
# --with-logs on it with exit 2 (contract Q8), so neither ai_explain nor
# ai_set_with_logs below is reached from the command line any more.
fn ai_build() { return 0; }

# Lean-build peer of ai.cyr's ai_set_with_logs. Returns non-zero so the CLI can
# refuse `--with-logs` outright rather than accepting a flag that could not
# possibly do anything here — the lean build assembles no prompts at all.
fn ai_set_with_logs(on) {
    if (on == 1) { return 1; }
    return 0;
}

fn ai_explain(pid) {
    eprintln("chakshu: AI explain is not in this build.");
    eprintln("chakshu: run the `shu-ai` build for --explain (hoosh-backed AI).");
    return EXIT_ERR;
}

# In-TUI `?` handler stub. tui.cyr calls this in raw/alt-screen mode, so
# write a brief overlay (not stderr) and wait for a keypress; the caller
# repaints the frame on return. The real streamed overlay is in src/ai.cyr.
fn ai_tui_explain(pid) {
    tty_clear();
    tty_move(1, 1);
    var m1 = "AI explain is not in this build.\r\n";
    var m2 = "Run the shu-ai build for the AI panel.\r\n\r\n";
    var m3 = "  [any key to close]";
    syscall(1, 1, m1, strlen(m1));
    syscall(1, 1, m2, strlen(m2));
    syscall(1, 1, m3, strlen(m3));
    return _ai_stub_wait_key();
}

# R14 (v0.7.13): wait for a key OR an exit signal. A bare read(0,..,1) here left
# `kill` inert for as long as the overlay was open, because the TUI's signalfd
# has HUP/INT/TERM blocked and nothing drains it while we sit in read().
# Returns 1 if an exit signal arrived (caller should unwind), 0 on a keypress.
fn _ai_stub_wait_key() {
    #ifdef CYRIUS_TARGET_AGNOS
    # v0.11.0: on agnos keys arrive through kbscan, not fd 0 (src/tui_agnos.cyr),
    # and the TUI opens no signalfd, so wait on the same decoder the TUI loop
    # polls. ⛔ Through v0.10.3 this fell into the `_tui_sfd_exit < 0` branch
    # below, whose `syscall(0, ...)` is read(2) on Linux and EXIT (#0) on agnos:
    # pressing `?` ended shu on the spot, with the alt screen still up and the
    # cursor hidden. tests/agnos_qemu.py scenario [6] covers it.
    while (_ag_next_key() < 0) { sleep_ms(30); }
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (_tui_sfd_exit < 0) {
        # Degraded launch: no signalfd, signals have normal disposition, so a
        # plain blocking read is already interruptible.
        var kb0[4];
        syscall(0, 0, &kb0, 1);
        return 0;
    }
    var pfd[16];
    store64(&pfd,     4294967296);                          # { fd=0,  events=POLLIN }
    store64(&pfd + 8, _tui_sfd_exit + 4294967296);          # { fd=sfd, events=POLLIN }
    var r = syscall(7, &pfd, 2, 0 - 1);                     # poll(fds, 2, timeout=-1)
    if (r > 0) {
        # revents live in the high 16 bits of each 8-byte pollfd.
        if (load16(&pfd + 8 + 6) != 0) { return 1; }        # signal arrived
        var kb[4];
        syscall(0, 0, &kb, 1);
    }
    return 0;
    #endif
}
