# cli.cyr — shared CLI surface: version/help, stderr helpers, and mode
# dispatch. The parsing is src/cli_parse.cyr (pure, on cmdit, unit-tested). Included by BOTH build entries:
#   - src/main.cyr  → lean `shu`   (monitor only; ai_stub.cyr)
#   - ai/main.cyr   → `shu-ai`     (adds src/ai.cyr + sandhi/niyama)
# Both call chakshu_main(). The only difference between the binaries is
# which ai module (ai.cyr vs ai_stub.cyr) and deps are linked, so the CLI
# logic lives here once. `ai_explain` resolves to whichever is included.

# Keep CHAKSHU_VERSION in sync with the VERSION file.
var CHAKSHU_VERSION = "chakshu 0.12.1";

# Exit codes per design-spec §9
var EXIT_OK    = 0;
var EXIT_ERR   = 1;
var EXIT_USAGE = 2;

fn print_version() {
    println(CHAKSHU_VERSION);
    return EXIT_OK;
}

fn print_help() {
    println("chakshu — system monitor for AGNOS (AI-augmented in the shu-ai build)");
    println("");
    println("Usage:");
    println("  shu [OPTIONS]            Full TUI: ↑↓ select, s sort, f filter, k kill, q quit");
    println("  shu -p                   Plain snapshot (host/uptime/load/mem/cpu/disk/net + top-N process table)");
    println("  shu --pid <PID>          Focus a single process (status / cmdline / k to kill)");
    println("  shu --explain <PID>      AI explain via hoosh (shu-ai build only)");
    println("  shu --watch              Anomaly stream — tail aegis security events");
    println("");
    println("Options:");
    println("  -p, --plain               Plain snapshot mode (single frame to stdout)");
    println("  --sort cpu|mem|pid|name|user  Process-table sort key (default cpu)");
    println("  --rows N                  Process-table row count (default 10). --top is the");
    println("                            same flag.");
    println("  --rate <HZ>               Refresh rate for the TUI and --watch, 0.2-10,");
    println("                            default 1. Fractional accepted: 0.5 = 2s (btop's");
    println("                            default), 0.667 = 1.5s (htop's default).");
    println("  --color <when>            auto | always | never (default auto; TUI, --watch)");
    println("                            auto honours $NO_COLOR, $TERM and whether");
    println("                            stdout is a terminal.");
    println("  --theme <name>            dark | light | auto (default dark; TUI, --watch)");
    println("                            light re-tints the colours that are unreadable");
    println("                            on a white background; auto reads $COLORFGBG.");
    println("  --pid <PID>               Focus a single process (validates PID exists at startup)");
    println("  --explain <PID>           Ask hoosh to explain PID and exit (shu-ai build;");
    println("                            redacted context). Exits 1 if hoosh does not answer,");
    println("                            after printing the context it would have sent.");
    println("  --watch                   Anomaly stream mode. Reads aegis's append-only");
    println("                            NDJSON event log. Non-TTY prints a plain dump;");
    println("                            a TTY gets the live panel.");
    println("  --watch-path <PATH>       The log --watch reads. Default: $CHAKSHU_WATCH_PATH,");
    println("                            then /var/log/aegis/events.jsonl.");
    println("  --with-logs               Fold recent log + anomaly context into AI prompts");
    println("                            (shu-ai only; off by default). Log path:");
    println("                            $CHAKSHU_LOG_PATH, else /var/log/aegis/aegis.log.");
    println("  -h, --help                Show this help");
    println("  -V, --version             Show version");
    println("");
    println("A value may follow its flag or be attached: --sort mem, --sort=mem. `--`");
    println("ends the options. A flag the chosen mode does not use is an error.");
    println("");
    println("Builds: lean `shu` is the monitor; `shu-ai` adds the AI panel");
    println("(--explain / ? via the hoosh gateway). See docs/development/roadmap.md.");
    return EXIT_OK;
}

# Per design-spec §9: errors go to stderr as `chakshu: <reason>`.
# Helpers: write a c-string (with/without newline) to stderr without
# manual byte counting. The em dash in the unimplemented message is
# 3 UTF-8 bytes; manual counts on multi-fragment messages have already
# bitten us twice (off-by-one on the unimplemented dash; off-by-one
# on the --sort error literal yielding a stray leading space). Use
# these for any new stderr writes.
fn eprint_cstr(s) {
    eprint(s, strlen(s));
    return 0;
}

fn eprintln(s) {
    eprint_cstr(s);
    eprint("\n", 1);
    return 0;
}

# --pid's existence probe. It opens /proc, so it is not in the pure parser, and
# it runs only once the TUI is the chosen mode: help, version and every usage
# error come first (`--pid 99999 --help` prints help).
fn _cli_pid_exists(pid) {
    var pid_str_v[24];
    _proc_int_to_cstr(pid, &pid_str_v);
    var stat_path_v[64];
    proc_pid_path(&pid_str_v, "/stat", &stat_path_v);
    var fd_v = file_open(&stat_path_v, 0, 0);
    if (fd_v < 0) {
        eprint_cstr("chakshu: --pid ");
        eprint_cstr(&pid_str_v);
        eprintln(": no such process");
        return 0;
    }
    file_close(fd_v);
    return 1;
}

# Parse (src/cli_parse.cyr, on cmdit), then run the one mode the command line
# chose. Mode precedence and every combination rule live in the parser; this
# function only maps results to exit codes and calls the mode.
fn chakshu_main() {
    var rc = cli_parse_process(ai_build());
    if (rc == CLI_HELP)    { return print_help(); }
    if (rc == CLI_VERSION) { return print_version(); }
    if (rc == CLI_USAGE) {
        eprintln(cli_err());
        return EXIT_USAGE;
    }
    if (rc != CLI_RUN) {
        eprintln(cli_err());
        return EXIT_ERR;
    }

    # The parser has already refused --with-logs on the lean build, so this
    # reaches ai.cyr's setter only.
    if (cli_with_logs == 1) { ai_set_with_logs(1); }

    if (cli_mode == CLI_MODE_EXPLAIN) { return ai_explain(cli_explain_pid); }
    if (cli_mode == CLI_MODE_WATCH) {
        tui_set_theme(cli_theme);
        return watch_run(_mhz_to_ms(cli_rate_mhz), cli_color, cli_watch_path);
    }
    if (cli_mode == CLI_MODE_PLAIN) { return snapshot_print(cli_sort, cli_rows); }

    # Default mode — the TUI. tui_run handles the not-a-TTY case (stdin
    # redirected) by exiting EXIT_ERR with a stderr message pointing at `-p`.
    if (cli_pid != 0) {
        if (_cli_pid_exists(cli_pid) == 0) { return EXIT_ERR; }
    }
    tui_set_theme(cli_theme);
    return tui_run(_mhz_to_ms(cli_rate_mhz), cli_sort, cli_rows, cli_color, cli_pid);
}
