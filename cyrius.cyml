# chakshu — lean `shu` build manifest.
# Rationale, dep history and binary sizes: docs/development/state.md ("Dependency
# Envelope"); per-bump detail: CHANGELOG.md. Keep this file to compilation facts.
[package]
name = "chakshu"
version = "${file:VERSION}"
description = "The eye — AI-augmented system monitor for AGNOS / Cyrius"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/chakshu"
language = "cyrius"
cyrius = "6.5.45"

[build]
entry = "src/main.cyr"
test = "tests/chakshu.tcyr"
output = "shu"

# LEAN BUILD — monitor only. No transport or redaction modules here; the AI chain
# lives solely in ai/cyrius.cyml (CI fails this manifest if one appears).
# Most entries below are parse-time leaves named by the deps' dist/*.deps
# sidecars — union those and diff against this list on every dep bump.
[deps]
stdlib = [
    "syscalls",
    "alloc",
    "fmt",
    "io",
    "fs",
    "str",
    "string",
    "slice",
    "vec",
    "args",
    "chrono",
    "hashmap",
    "process",
    "tagged",
    "assert",
    "sys",
    "fnptr",
    "sakshi",
    "thread",
    "freelist",
    "ct",
    "bench",
]

# TTY/raw-mode primitives (termios, ANSI, cursor); v1.0 API freeze, ADR 0003.
# Needs the syscalls entry above — darshana no longer defines its own SYS_IOCTL.
[deps.darshana]
git = "https://github.com/MacCracken/darshana.git"
tag = "1.0.0"
modules = ["dist/darshana.cyr"]

# Identity/static probes (hostname/kernel/distro/cpu/mem/uptime/gpu_*).
# Per-frame deltas stay chakshu-local.
[deps.mihi]
git = "https://github.com/MacCracken/mihi.git"
tag = "1.2.5"
modules = ["dist/mihi.cyr"]

# Transitive via mihi/gpu.cyr. Pin TRACKS mihi's own [deps.ai-hwaccel] tag,
# NOT ai-hwaccel's latest release; the two must move together.
[deps.ai-hwaccel]
git = "https://github.com/MacCracken/ai-hwaccel.git"
tag = "2.3.19"
modules = ["dist/ai-hwaccel.cyr"]
